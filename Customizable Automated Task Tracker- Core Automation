// Copies every row matching this bundle's name onto Task List - same field-matching, Days to
// Complete, and chip-preserving Website copy as Add Recurring, just with no date math and no
// "already added" tracking. Bundles are meant to be reusable - the next new hire reruns
// "New Hire" again on purpose.
function addTaskBundle(projectName) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var bundlesSheet = ss.getSheetByName(TASK_BUNDLES_SHEET);
  var taskListSheet = ss.getSheetByName(TASK_LIST_SHEET);
  if (!bundlesSheet || !taskListSheet) {
    SpreadsheetApp.getUi().alert("Couldn't find the \"" + TASK_BUNDLES_SHEET + "\" or \"" + TASK_LIST_SHEET + "\" tab.");
    return;
  }

  var bundleCols = getColumnMap(bundlesSheet, OTHER_SHEETS_HEADER_ROW);
  var taskListCols = getColumnMap(taskListSheet, TASK_LIST_HEADER_ROW);
  if (!requireColumns(bundleCols, [COL_BUNDLE_PROJECT], TASK_BUNDLES_SHEET, OTHER_SHEETS_HEADER_ROW)) return;
  if (!requireColumns(taskListCols, [COL_TASK_ADDED], TASK_LIST_SHEET, TASK_LIST_HEADER_ROW)) return;

  var sharedFields = Object.keys(taskListCols).filter(function(name) {
    return bundleCols.hasOwnProperty(name);
  });
  if (sharedFields.length === 0) {
    SpreadsheetApp.getUi().alert(
      "Couldn't find any matching column headers between \"" + TASK_BUNDLES_SHEET + "\" and \"" + TASK_LIST_SHEET +
      "\". Task Bundles need at least one shared column (like \"Task List\") to know what to copy."
    );
    return;
  }

  var projectCol = getCol(bundleCols, COL_BUNDLE_PROJECT);
  var lastRow = bundlesSheet.getLastRow();
  var numRows = lastRow - OTHER_SHEETS_HEADER_ROW;
  if (numRows <= 0) {
    SpreadsheetApp.getUi().alert(
      "No tasks found with a \"" + COL_BUNDLE_PROJECT + "\" of \"" + projectName + "\" on \"" + TASK_BUNDLES_SHEET + "\"."
    );
    return;
  }

  // Read the whole Task Bundles block in one shot and match rows + pull field values off that,
  // instead of round-tripping per cell.
  var bundlesLastCol = bundlesSheet.getLastColumn();
  var bundlesData = bundlesSheet.getRange(OTHER_SHEETS_HEADER_ROW + 1, 1, numRows, bundlesLastCol).getValues();

  var normalizedProject = normalizeHeader(projectName);
  var matchingRowIndexes = []; // 0-based index into bundlesData
  for (var r = 0; r < bundlesData.length; r++) {
    var rowProject = bundlesData[r][projectCol - 1];
    if (rowProject && normalizeHeader(rowProject) === normalizedProject) matchingRowIndexes.push(r);
  }

  if (matchingRowIndexes.length === 0) {
    SpreadsheetApp.getUi().alert(
      "No tasks found with a \"" + COL_BUNDLE_PROJECT + "\" of \"" + projectName + "\" on \"" + TASK_BUNDLES_SHEET + "\"."
    );
    return;
  }

  var daysToCompleteCol = getCol(bundleCols, COL_DAYS_TO_COMPLETE); // optional field, same as Recurring
  var today = todayDateOnly();
  var timeZone = getUserTimeZone();
  var nowFormatted = Utilities.formatDate(new Date(), timeZone, "yyyy-MM-dd HH:mm:ss");
  var taskAddedCol = getCol(taskListCols, COL_TASK_ADDED);
  var deadlineColOnTaskList = getCol(taskListCols, COL_DEADLINE);
  var linkColOnBundles = getCol(bundleCols, COL_LINK);
  var linkColOnTaskList = getCol(taskListCols, COL_LINK);
  var nextRow = taskListSheet.getLastRow() + 1;
  var taskListLastCol = taskListSheet.getLastColumn();

  // Build every new row in memory first, then write it all in one call - that's what actually
  // makes this fast, and why a row now appears fully filled in at once instead of field by field.
  var outputRows = matchingRowIndexes.map(function(rowIndex) {
    var sourceRowValues = bundlesData[rowIndex];
    var outRow = new Array(taskListLastCol).fill("");
    sharedFields.forEach(function(name) {
      if (name === normalizeHeader(COL_LINK)) return; // handled below via copyTo, preserves Smart Chips
      outRow[taskListCols[name] - 1] = sourceRowValues[bundleCols[name] - 1];
    });
    if (taskAddedCol) outRow[taskAddedCol - 1] = nowFormatted;
    if (daysToCompleteCol && deadlineColOnTaskList) {
      var daysToComplete = sourceRowValues[daysToCompleteCol - 1];
      if (daysToComplete !== "" && !isNaN(daysToComplete)) {
        var deadlineDate = new Date(today);
        deadlineDate.setDate(deadlineDate.getDate() + (Number(daysToComplete) - 1));
        outRow[deadlineColOnTaskList - 1] = deadlineDate;
      }
    }
    return outRow;
  });

  taskListSheet.getRange(nextRow, 1, outputRows.length, taskListLastCol).setValues(outputRows);

  // Website still needs a real cell copy to keep its Smart Chip - a plain values array can't
  // hold a chip. Still just one call per row though, not one per field.
  if (linkColOnBundles && linkColOnTaskList) {
    matchingRowIndexes.forEach(function(rowIndex, i) {
      var sourceRow = OTHER_SHEETS_HEADER_ROW + 1 + rowIndex;
      var targetRow = nextRow + i;
      bundlesSheet.getRange(sourceRow, linkColOnBundles)
        .copyTo(taskListSheet.getRange(targetRow, linkColOnTaskList));
    });
  }

  sortTaskListByDeadlineThenPriority();
  SpreadsheetApp.getActiveSpreadsheet().toast(
    "Added " + matchingRowIndexes.length + " task(s) from \"" + projectName + "\".", "✓ Task Bundle", 4
  );
}

/** ====================== SORTING ====================== */

// Reads your live Priority Options list, top to bottom. Reorder or edit that list and sort
// order updates automatically, no code changes. Falls back to PRIORITY_ORDER above only if
// that column is missing or empty.
function getPriorityOrder() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(RECURRING_SHEET);
  if (!sheet) return PRIORITY_ORDER;

  var cols = getColumnMap(sheet, OTHER_SHEETS_HEADER_ROW);
  var col = getCol(cols, COL_PRIORITY_OPTIONS);
  if (!col) {
    SpreadsheetApp.getUi().alert(
      "Couldn't find a \"" + COL_PRIORITY_OPTIONS + "\" column on \"" + RECURRING_SHEET + "\", so sorting is " +
      "using the built-in default Priority order instead of your custom one.\n\n" +
      "Rename that column's header to exactly \"" + COL_PRIORITY_OPTIONS + "\" to fix this."
    );
    return PRIORITY_ORDER;
  }

  var lastRow = sheet.getLastRow();
  var numRows = lastRow - OTHER_SHEETS_HEADER_ROW;
  if (numRows <= 0) return PRIORITY_ORDER;

  var values = sheet.getRange(OTHER_SHEETS_HEADER_ROW + 1, col, numRows, 1).getValues()
    .map(function(row) { return row[0]; })
    .filter(function(v) { return v !== ""; });

  return values.length > 0 ? values : PRIORITY_ORDER;
}

// Rank for a cell's text: position in orderList (0 = highest). Unrecognized or blank values
// sort to the very end instead of breaking the sort.
function priorityRank(value, orderList) {
  var normalized = normalizeHeader(value);
  for (var i = 0; i < orderList.length; i++) {
    if (normalizeHeader(orderList[i]) === normalized) return i;
  }
  return orderList.length;
}

// Sheets' built-in sort only does alphabetical/numeric order, which can't express a custom
// priority ranking. This physically moves rows instead (the same thing that happens when you
// drag a row in the UI) rather than rewriting cell values - rewriting values would flatten any
// Smart Chip in the row (like in Website) down to plain text.
function sortTaskListByDeadlineThenPriority() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(TASK_LIST_SHEET);
  var cols = getColumnMap(sheet, TASK_LIST_HEADER_ROW);

  if (!requireColumns(cols, [COL_PRIORITY, COL_DEADLINE], TASK_LIST_SHEET, TASK_LIST_HEADER_ROW)) return;

  var firstDataRow = TASK_LIST_HEADER_ROW + 1;
  var lastRow = sheet.getLastRow();
  var numRows = lastRow - TASK_LIST_HEADER_ROW;
  var numCols = sheet.getLastColumn();
  if (numRows <= 1) return; // nothing to reorder

  var deadlineCol = getCol(cols, COL_DEADLINE);
  var priorityCol = getCol(cols, COL_PRIORITY);
  var priorityOrder = getPriorityOrder(); // read once, not per-row comparison

  // Only read the two sort-key columns, never the whole row, so nothing richer ever passes
  // through a plain array.
  var deadlineValues = sheet.getRange(firstDataRow, deadlineCol, numRows, 1).getValues();
  var priorityValues = sheet.getRange(firstDataRow, priorityCol, numRows, 1).getValues();

  var entries = [];
  for (var i = 0; i < numRows; i++) {
    entries.push({
      originalOffset: i, // 0-based offset from firstDataRow, BEFORE any moves
      deadline: deadlineValues[i][0] instanceof Date ? deadlineValues[i][0].getTime() : Infinity, // blank -> last
      priority: priorityRank(priorityValues[i][0], priorityOrder)
    });
  }

  var sortedEntries = entries.slice().sort(function(a, b) {
    if (a.deadline !== b.deadline) return a.deadline - b.deadline;
    return a.priority - b.priority;
  });

  // currentOffset[originalOffset] tracks where that row actually sits right now (0-based, relative
  // to firstDataRow) as moves happen - every move shifts everything between the old and new spot.
  var currentOffset = entries.map(function(e) { return e.originalOffset; });

  for (var target = 0; target < sortedEntries.length; target++) {
    var wantedOriginalOffset = sortedEntries[target].originalOffset;
    var fromOffset = currentOffset[wantedOriginalOffset];
    if (fromOffset === target) continue; // already correctly placed

    // Rows [0, target) are already finalized from earlier iterations and never revisited, so the
    // row we want for `target` is always still somewhere at or after it (fromOffset >= target) -
    // this only ever moves a row UPWARD, never down.
    var sourceRow = firstDataRow + fromOffset;
    var destRow = firstDataRow + target;
    sheet.moveRows(sheet.getRange(sourceRow, 1, 1, numCols), destRow);

    // Everything that was sitting in [target, fromOffset) got pushed down by one row to make room.
    for (var idx = 0; idx < currentOffset.length; idx++) {
      if (currentOffset[idx] >= target && currentOffset[idx] < fromOffset) currentOffset[idx]++;
    }
    currentOffset[wantedOriginalOffset] = target;
  }

  ss.toast("Sorted: Deadline > Priority", "Task List", 4);
}

/** ====================== OVERDUE DEADLINE HIGHLIGHTING ======================
 *  Uses Sheets' own conditional formatting instead of script-driven coloring, so it stays
 *  accurate every day on its own - no trigger needed.
 */

function setUpOverdueDeadlineFormatting() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var problems = [];
  [TASK_LIST_SHEET, PARKED_SHEET].forEach(function(sheetName) {
    var sheet = ss.getSheetByName(sheetName);
    if (!sheet) { problems.push("Couldn't find a tab named \"" + sheetName + "\"."); return; }

    var headerRow = headerRowFor(sheetName);
    var cols = getColumnMap(sheet, headerRow);
    var deadlineCol = getCol(cols, COL_DEADLINE);
    if (!deadlineCol) {
      problems.push("Couldn't find \"" + COL_DEADLINE + "\" on \"" + sheetName + "\" row " + headerRow + ".");
      return;
    }

    var firstDataRow = headerRow + 1;
    var range = sheet.getRange(firstDataRow, deadlineCol, Math.max(sheet.getMaxRows() - headerRow, 1), 1);
    var topLeftA1 = range.getCell(1, 1).getA1Notation();

    // Drop any prior rule on this exact range first, so re-running this doesn't stack duplicates.
    var rules = sheet.getConditionalFormatRules().filter(function(rule) {
      var ranges = rule.getRanges();
      return !(ranges.length === 1 && ranges[0].getA1Notation() === range.getA1Notation());
    });

    rules.push(
      SpreadsheetApp.newConditionalFormatRule()
        .whenFormulaSatisfied("=AND(ISDATE(" + topLeftA1 + ")," + topLeftA1 + "<TODAY())")
        .setBackground("#f4c7c3")
        .setRanges([range])
        .build()
    );
    sheet.setConditionalFormatRules(rules);
  });

  if (problems.length > 0) {
    SpreadsheetApp.getUi().alert(
      "Overdue-deadline highlighting couldn't be fully set up:\n" +
      problems.map(function(p) { return "• " + p; }).join("\n") +
      "\n\nFix this, then run the timezone/trigger setup again."
    );
  }
}

/** ====================== TIMEZONE-AWARE TRIGGER SETUP ====================== */

function openTimezoneSyncDialog() {
  var html = HtmlService.createHtmlOutputFromFile('TimezoneSync')
      .setWidth(440)
      .setHeight(340);
  SpreadsheetApp.getUi().showModalDialog(html, 'Set Up Recurring Task Schedule');
}

// Called from TimezoneSync.html once the user confirms (or corrects) their timezone
function finalizeTriggerSetup(timeZone) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(RECURRING_SHEET);

  if (!sheet) {
    return { success: false, message: "Couldn't find a tab named \"Recurring\"." };
  }

  var cols = getColumnMap(sheet, OTHER_SHEETS_HEADER_ROW);
  if (!requireColumns(cols, [COL_TRIGGER_ENABLED, COL_TRIGGER_DAY, COL_TRIGGER_HOUR], RECURRING_SHEET, OTHER_SHEETS_HEADER_ROW)) {
    return { success: false, message: "Couldn't find the trigger table headers (\"Add Trigger\", \"Day of Week\", \"Time\") on Recurring." };
  }

  var enabledCol = getCol(cols, COL_TRIGGER_ENABLED);
  var dayCol = getCol(cols, COL_TRIGGER_DAY);
  var hourCol = getCol(cols, COL_TRIGGER_HOUR);

  PropertiesService.getDocumentProperties().setProperty(TIMEZONE_PROPERTY_KEY, timeZone);
  ss.setSpreadsheetTimeZone(timeZone);
  // Same column as "Add Trigger", just a couple rows below the 7-day block - follows the table
  // wherever it's positioned instead of a fixed cell that'd go stale if things got moved around.
  var timezoneDisplayRow = OTHER_SHEETS_HEADER_ROW + 1 + TRIGGER_TABLE_ROWS + 2;
  // Clear out any old "Detected Timezone" line before writing a new one, so re-running this
  // never leaves a stray duplicate sitting nearby.
  var cleanupRange = sheet.getRange(OTHER_SHEETS_HEADER_ROW + 1, enabledCol, TRIGGER_TABLE_ROWS + 10, 1);
  var cleanupValues = cleanupRange.getValues();
  var cleanupChanged = false;
  for (var c = 0; c < cleanupValues.length; c++) {
    if (String(cleanupValues[c][0]).indexOf("Detected Timezone:") === 0) {
      cleanupValues[c][0] = "";
      cleanupChanged = true;
    }
  }
  if (cleanupChanged) cleanupRange.setValues(cleanupValues);
  sheet.getRange(timezoneDisplayRow, enabledCol).setValue("Detected Timezone: " + timeZone);
  var startCol = Math.min(enabledCol, dayCol, hourCol);
  var endCol = Math.max(enabledCol, dayCol, hourCol);
  var data = sheet.getRange(OTHER_SHEETS_HEADER_ROW + 1, startCol, TRIGGER_TABLE_ROWS, endCol - startCol + 1).getValues();

  var hasError = false;
  var anyChecked = false;

  var processedData = data.map(function(rowData) {
    var isEnabled = rowData[enabledCol - startCol];
    var dayStr = rowData[dayCol - startCol];
    var rawHour = rowData[hourCol - startCol];
    var hourValue = null;

    if (isEnabled === true) {
      anyChecked = true;
      if (rawHour instanceof Date) {
        hourValue = rawHour.getHours();
      } else if (!isNaN(rawHour) && rawHour !== "") {
        hourValue = parseInt(rawHour);
      }
      if (hourValue === null || hourValue < 0 || hourValue > 23) {
        hasError = true;
      }
    }
    return { enabled: isEnabled, day: dayStr, hour: hourValue };
  });

  if (!anyChecked || hasError) {
    return {
      success: false,
      message: "Please check the box for each day you want Daily-type tasks added, " +
        "and set an hour (0-23) for each checked day."
    };
  }

  var allTriggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < allTriggers.length; i++) {
    if (allTriggers[i].getHandlerFunction() === "copyRecurringTasks") {
      ScriptApp.deleteTrigger(allTriggers[i]);
    }
  }

  // One trigger per checked day, just for Daily tasks - lets those follow a work schedule
  // instead of firing literally every day.
  var createdCount = 0;
  var firstHour = null;
  processedData.forEach(function(item) {
    if (item.enabled === true) {
      // Google's WeekDay enum keys are fixed English constants and can't be localized, but this
      // is still forgiving of case and stray whitespace ("monday", " Monday " both work).
      var dayEnum = ScriptApp.WeekDay[normalizeHeader(item.day).toUpperCase()];
      if (dayEnum) {
        ScriptApp.newTrigger("copyRecurringTasks")
          .timeBased()
          .onWeekDay(dayEnum)
          .atHour(item.hour)
          .inTimezone(timeZone)
          .create();
        createdCount++;
        if (firstHour === null) firstHour = item.hour;
      }
    }
  });

  // One trigger that runs every single day, for Week/Month/Quarter/Year rules - guarantees these
  // are always checked on their exact target day, independent of which days are checked above.
  ScriptApp.newTrigger("copyRecurringTasks")
    .timeBased()
    .everyDays(1)
    .atHour(firstHour !== null ? firstHour : 2)
    .inTimezone(timeZone)
    .create();

  setUpOverdueDeadlineFormatting();

  return {
    success: true,
    message: "Success! Automated schedule updated.\nTimezone: " + timeZone + "\nDaily-task days: " + createdCount
  };
}

// Timezone to use for background trigger runs, when there's no browser to detect from.
// Falls back to the spreadsheet's own timezone setting if the sync dialog has never been run.
function getUserTimeZone() {
  var stored = PropertiesService.getDocumentProperties().getProperty(TIMEZONE_PROPERTY_KEY);
  if (stored) return stored;
  return SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
}
