function sortByDeadlineThenPriority() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  
  // Settings based on template specific "Task List" tab
  const firstDataRow = 3; 
  const priorityCol = 4; // Column D
  const deadlineCol = 5; // Column E
  
  const lastRow = sheet.getLastRow();
  const numRows = lastRow - (firstDataRow - 1);
  const numCols = sheet.getLastColumn();

  if (numRows <= 0) return;

  const range = sheet.getRange(firstDataRow, 1, numRows, numCols);

  /**
   * THE LOGIC:
   * 1. Sort by Deadline (Col 5) first.
   * 2. If Deadlines are the same, sort by Priority (Col 4).
   */
  range.sort([
    {column: deadlineCol, ascending: true}, // Earliest Dates first
    {column: priorityCol, ascending: true}  // Then 1 - Recurring, 2 - Top, etc.
  ]);

  SpreadsheetApp.getActiveSpreadsheet().toast("Sorted: Deadline > Priority", "Priority Matrix");
}
